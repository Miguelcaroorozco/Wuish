// Prisma Schema — Maps existing PostgreSQL tables for Wuish
// Run: npx prisma db push (to sync) or npx prisma db pull (to introspect)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombres          String   @db.VarChar(100)
  apellidos        String   @db.VarChar(100)
  numero_cedula    String   @unique @db.VarChar(30)
  tipo_documento   String   @db.VarChar(20)
  fecha_nacimiento DateTime @db.Date
  telefono         String?  @db.VarChar(20)
  correo           String   @unique @db.VarChar(150)
  password_hash    String?  @db.VarChar(255)
  rol              String   @default("usuario") @db.VarChar(20)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  // Relations
  info_general_updates InfoGeneral[]        @relation("UpdatedByUser")
  carrito_items        CarritoItem[]
  solicitudes          Solicitud[]          @relation("SolicitudUsuario")
  solicitudes_admin    Solicitud[]          @relation("SolicitudAdmin")
  ajustes_respondidos  SolicitudAjuste[]
  mensajes             Mensaje[]
  comentarios          Comentario[]

  @@map("usuarios")
}

model InfoGeneral {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seccion    String   @db.VarChar(100)
  contenido  String?  @db.Text
  updated_at DateTime @default(now()) @updatedAt
  updated_by String?  @db.Uuid

  // Relations
  updatedByUser Usuario? @relation("UpdatedByUser", fields: [updated_by], references: [id])

  @@map("info_general")
}

model Equipo {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre      String  @db.VarChar(100)
  cargo       String? @db.VarChar(100)
  foto_url    String? @db.VarChar(255)
  descripcion String? @db.Text
  orden       Int?

  @@map("equipo")
}

model TipoServicio {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text

  // Relations
  planes Plan[]

  @@map("tipos_servicio")
}

model Plan {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tipo_servicio_id String   @db.Uuid
  nombre           String   @db.VarChar(100)
  descripcion      String?  @db.Text
  precio           Decimal? @db.Decimal(12, 2)
  caracteristicas  Json?
  activo           Boolean  @default(true)

  // Relations
  tipo_servicio  TipoServicio  @relation(fields: [tipo_servicio_id], references: [id])
  carrito_items  CarritoItem[]
  solicitudes    Solicitud[]

  @@map("planes")
}

model CarritoItem {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id String   @db.Uuid
  plan_id    String   @db.Uuid
  cantidad   Int      @default(1)
  created_at DateTime @default(now())

  // Relations
  usuario Usuario @relation(fields: [usuario_id], references: [id])
  plan    Plan    @relation(fields: [plan_id], references: [id])

  @@map("carrito_items")
}

model Solicitud {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id           String    @db.Uuid
  tipo                 String    @db.VarChar(30)
  estado               String    @default("pendiente") @db.VarChar(30)
  descripcion          String?   @db.Text
  plan_id              String?   @db.Uuid
  admin_asignado_id    String?   @db.Uuid
  fecha_solicitud      DateTime  @default(now())
  fecha_limite_borrado DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @default(now()) @updatedAt

  // Relations
  usuario        Usuario                    @relation("SolicitudUsuario", fields: [usuario_id], references: [id])
  plan           Plan?                      @relation(fields: [plan_id], references: [id])
  admin_asignado Usuario?                   @relation("SolicitudAdmin", fields: [admin_asignado_id], references: [id])
  ajustes        SolicitudAjuste[]
  mensajes       Mensaje[]
  historial      SolicitudHistorialEstado[]

  @@map("solicitudes")
}

model SolicitudAjuste {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  solicitud_id       String   @db.Uuid
  descripcion_ajuste String   @db.Text
  respondido_por     String   @db.Uuid
  created_at         DateTime @default(now())

  // Relations
  solicitud    Solicitud @relation(fields: [solicitud_id], references: [id])
  respondidoPor Usuario  @relation(fields: [respondido_por], references: [id])

  @@map("solicitud_ajustes")
}

model Mensaje {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id   String   @db.Uuid
  solicitud_id String?  @db.Uuid
  asunto       String?  @db.VarChar(150)
  contenido    String   @db.Text
  leido        Boolean  @default(false)
  created_at   DateTime @default(now())

  // Relations
  usuario   Usuario    @relation(fields: [usuario_id], references: [id])
  solicitud Solicitud? @relation(fields: [solicitud_id], references: [id])

  @@map("mensajes")
}

model SolicitudHistorialEstado {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  solicitud_id    String   @db.Uuid
  estado_anterior String?  @db.VarChar(50)
  estado_nuevo    String   @db.VarChar(50)
  motivo          String?  @db.VarChar(255)
  changed_at      DateTime @default(now())

  // Relations
  solicitud Solicitud @relation(fields: [solicitud_id], references: [id])

  @@map("solicitud_historial_estados")
}

model Comentario {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id        String?  @db.Uuid
  contenido         String   @db.Text
  calificacion      Int?
  mostrar_en_pagina Boolean  @default(false)
  orden             Int?
  created_at        DateTime @default(now())

  // Relations
  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@map("comentarios")
}

model Resultado {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  titulo      String  @db.VarChar(150)
  descripcion String? @db.Text
  imagen_url  String? @db.VarChar(255)
  activo      Boolean @default(true)
  orden       Int?

  @@map("resultados")
}

model PasoProceso {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  numero_paso Int
  titulo      String  @db.VarChar(150)
  descripcion String? @db.Text
  icono       String? @db.VarChar(100)

  @@map("pasos_proceso")
}
