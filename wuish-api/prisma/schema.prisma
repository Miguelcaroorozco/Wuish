// Prisma Schema — Ecosistema Wuish
// Reorganizado y optimizado para la plataforma Wuish

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. USUARIOS (Clientes y Administradores)
model Usuario {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombres          String   @db.VarChar(100)
  apellidos        String   @db.VarChar(100)
  numero_cedula    String   @unique @db.VarChar(30)
  tipo_documento   String   @db.VarChar(20)
  empresa          String?  @db.VarChar(150)
  cargo            String?  @db.VarChar(100)
  fecha_nacimiento DateTime @db.Date
  telefono         String?  @db.VarChar(20)
  correo           String   @unique @db.VarChar(150)
  password_hash    String?  @db.VarChar(255)
  rol              String   @default("usuario") @db.VarChar(20)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  // Relations
  info_general_updates InfoGeneral[] @relation("UpdatedByUser")
  solicitudes          Solicitud[]   @relation("SolicitudUsuario")
  solicitudes_admin    Solicitud[]   @relation("SolicitudAdmin")
  mensajes             Mensaje[]
  comentarios          Comentario[]

  @@map("usuarios")
}

// 2. INFO GENERAL / CMS (Eslogan, Misión, Visión, etc.)
model InfoGeneral {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  seccion    String   @unique @db.VarChar(100)
  contenido  String?  @db.Text
  updated_at DateTime @default(now()) @updatedAt
  updated_by String?  @db.Uuid

  updatedByUser Usuario? @relation("UpdatedByUser", fields: [updated_by], references: [id])

  @@map("info_general")
}

// 3. TIPOS DE SERVICIO (Líneas de Negocio: Desarrollo, Comunicación, etc.)
model TipoServicio {
  id          String  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre      String  @db.VarChar(100)
  descripcion String? @db.Text

  planes Plan[]

  @@map("tipos_servicio")
}

// 4. PLANES (Plantillas base del cotizador y paquetes comerciales)
model Plan {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tipo_servicio_id String   @db.Uuid
  nombre           String   @db.VarChar(100)
  descripcion      String?  @db.Text
  precio           Decimal? @db.Decimal(12, 2)
  caracteristicas  Json?
  activo           Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  tipo_servicio TipoServicio @relation(fields: [tipo_servicio_id], references: [id])
  solicitudes   Solicitud[]

  @@map("planes")
}

// 5. MÓDULOS DEL COTIZADOR (Servicios y requerimientos seleccionables)
model CotizadorModulo {
  id          String   @id @db.VarChar(60)
  nombre      String   @db.VarChar(150)
  categoria   String   @db.VarChar(50) // 'comunicacion' | 'tecnologia'
  precio_base Decimal  @db.Decimal(12, 2)
  descripcion String   @db.Text
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@map("cotizador_modulos")
}

// 6. SOLICITUDES & COTIZACIONES
model Solicitud {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id              String    @db.Uuid
  tipo                    String    @default("cotizacion") @db.VarChar(30)
  estado                  String    @default("pendiente") @db.VarChar(30)
  plan_id                 String?   @db.Uuid
  empresa                 String?   @db.VarChar(150)
  telefono_contacto       String?   @db.VarChar(30)
  servicios_seleccionados Json?
  presupuesto_min         Decimal?  @db.Decimal(12, 2)
  presupuesto_max         Decimal?  @db.Decimal(12, 2)
  velocidad_entrega       String?   @db.VarChar(30)
  nivel_soporte           String?   @db.VarChar(30)
  descripcion             String?   @db.Text
  admin_asignado_id       String?   @db.Uuid
  fecha_solicitud         DateTime  @default(now())
  fecha_limite_borrado    DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt

  usuario        Usuario                    @relation("SolicitudUsuario", fields: [usuario_id], references: [id])
  plan           Plan?                      @relation(fields: [plan_id], references: [id])
  admin_asignado Usuario?                   @relation("SolicitudAdmin", fields: [admin_asignado_id], references: [id])
  mensajes       Mensaje[]
  historial      SolicitudHistorialEstado[]

  @@map("solicitudes")
}

// 7. HISTORIAL DE ESTADOS (Auditoría de estados en solicitudes)
model SolicitudHistorialEstado {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  solicitud_id    String   @db.Uuid
  estado_anterior String?  @db.VarChar(50)
  estado_nuevo    String   @db.VarChar(50)
  motivo          String?  @db.VarChar(255)
  changed_at      DateTime @default(now())

  solicitud Solicitud @relation(fields: [solicitud_id], references: [id], onDelete: Cascade)

  @@map("solicitud_historial_estados")
}

// 8. MENSAJES (Chat directo entre cliente y administración)
model Mensaje {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id   String   @db.Uuid
  solicitud_id String?  @db.Uuid
  asunto       String?  @db.VarChar(150)
  contenido    String   @db.Text
  es_admin     Boolean  @default(false)
  leido        Boolean  @default(false)
  created_at   DateTime @default(now())

  usuario   Usuario    @relation(fields: [usuario_id], references: [id])
  solicitud Solicitud? @relation(fields: [solicitud_id], references: [id], onDelete: SetNull)

  @@map("mensajes")
}

// 9. PROYECTOS / PORTAFOLIO (Casos de éxito y portafolio interactivo)
model ProyectoPortafolio {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  titulo      String   @db.VarChar(150)
  cliente     String?  @db.VarChar(150)
  categoria   String   @db.VarChar(50) // 'comunicacion' | 'tecnologia'
  anio        String?  @db.VarChar(10)
  descripcion String?  @db.Text
  imagen_url  String?  @db.VarChar(255)
  tags        Json?
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt

  @@map("proyectos_portafolio")
}

// 10. MÉTRICAS DE LA LANDING (Stats dinámicos: 120+ Proyectos, 98% Retención, etc.)
model MetricaLanding {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  valor      Int
  sufijo     String   @default("+") @db.VarChar(10)
  etiqueta   String   @db.VarChar(100)
  orden      Int      @default(0)
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@map("metricas_landing")
}

// 11. COMENTARIOS / TESTIMONIOS (Reseñas de clientes aprobadas)
model Comentario {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id        String?  @db.Uuid
  nombre_autor      String?  @db.VarChar(100)
  empresa_autor     String?  @db.VarChar(100)
  contenido         String   @db.Text
  calificacion      Int?     @default(5)
  mostrar_en_pagina Boolean  @default(false)
  orden             Int?     @default(0)
  created_at        DateTime @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: SetNull)

  @@map("comentarios")
}
